# =============================================================================
# Project ARES — Environment Configuration
# =============================================================================
# Copy this file to .env and add your live IBM Bob or IBM Cloud watsonx API key:
#   copy .env.example .env
#
# NOTE: .env is ignored by git and will NEVER be committed.
# =============================================================================

# --- IBM Bob / IBM watsonx.ai API Credentials ---
# Option 1: IBM Bob / IBM Cloud API Key
BOB_API_KEY=your_api_key_here
# WATSONX_API_KEY=your_ibm_cloud_api_key_here

# Option 2: watsonx.ai Project ID (Required for watsonx cloud endpoints)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# API Gateway URL (defaults to IBM Cloud US South)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Target Foundation Model (Granite 3.0 8B Instruct)
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
WATSONX_GUARDIAN_MODEL_ID=ibm/granite-guardian-3.0-8b

# --- Server Configuration ---
ARES_PORT=8000
ARES_HOST=127.0.0.1
LOG_LEVEL=INFO
